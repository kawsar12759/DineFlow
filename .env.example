# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/dineflow

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Base URL of the app
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Proxies in front of the app that append to X-Forwarded-For (rate limiting
# keys on the client IP they report). 1 = Vercel or a single nginx/Caddy.
# Without any proxy there is no trustworthy client IP and IP limits are skipped.
TRUSTED_PROXY_HOPS=1

# Transactional email (Resend). Without these, emails are logged to the
# console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="DineFlow <bookings@yourdomain.com>"

# Public origin used in emailed links (falls back to the request origin).
APP_URL=http://localhost:3000

# Shared secret for the scheduled jobs (/api/cron/reminders and
# /api/cron/subscriptions), sent as "Authorization: Bearer <secret>".
CRON_SECRET=

# SSLCommerz, for restaurants paying their DineFlow subscription.
# Get sandbox credentials at https://developer.sslcommerz.com/registration/
# Without them, Billing shows plans but online payment is switched off.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# true = sandbox (test money). Set to false only with live credentials.
SSLCOMMERZ_SANDBOX=true

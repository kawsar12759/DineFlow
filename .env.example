# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/dineflow

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Base URL of the app
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Proxies in front of the app that append to X-Forwarded-For (rate limiting
# keys on the client IP they report). 1 = Vercel or a single nginx/Caddy.
# Without any proxy there is no trustworthy client IP and IP limits are skipped.
TRUSTED_PROXY_HOPS=1

# Transactional email (Resend). Without these, emails are logged to the
# console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="DineFlow <bookings@yourdomain.com>"

# Public origin used in emailed links (falls back to the request origin).
APP_URL=http://localhost:3000

# Shared secret for the reminder cron endpoint (/api/cron/reminders).
CRON_SECRET=
